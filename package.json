{
  "name": "quranpedia-mcp",
  "version": "2.3.0",
  "description": "Explore the Quran through 26 MCP tools backed by the Quranpedia API \u2014 mushafs, ayahs, surahs, tafsir, translations, books, fatwas, notes, topics, reciters, and categories. Hosted at mcp.quranpedia.net.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "cross-env TRANSPORT=http node dist/server.js",
    "dev": "tsx src/server.ts",
    "dev:http": "cross-env TRANSPORT=http tsx src/server.ts",
    "inspect": "yarn build && npx -y @modelcontextprotocol/inspector --transport stdio -- node dist/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,md}'",
    "test": "yarn build && yarn test:stdio && yarn test:http",
    "test:stdio": "node scripts/test.js",
    "test:http": "node scripts/test-http.js",
    "check:submission": "node scripts/check-submission.js",
    "prepublishOnly": "yarn build",
    "prepare": "husky"
  },
  "bin": {
    "quranpedia-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "plugin.json",
    "mcp.json"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "quran",
    "tafsir",
    "translation",
    "mushaf",
    "ayah",
    "surah",
    "quranpedia",
    "arabic",
    "claude",
    "ai"
  ],
  "mcpName": "io.github.quranpedia/quranpedia-mcp",
  "author": "quranpedia <contact@quranpedia.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quranpedia/quranpedia-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  }
}
